<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <UseWindowsForms>true</UseWindowsForms>
    <Nullable>enable</Nullable><AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <ImplicitUsings>enable</ImplicitUsings>
    <EnableWindowsTargeting>true</EnableWindowsTargeting>
    <AssemblyName>EpikStreamer</AssemblyName>
    <RootNamespace>EpikStreamer</RootNamespace>
    <Version>2.6.1</Version>
    <AssemblyVersion>2.6.1.0</AssemblyVersion>
    <FileVersion>2.6.1.0</FileVersion>
    <Product>EpikStreamer</Product>
    <ApplicationIcon>app.ico</ApplicationIcon>
    <!-- WebView2Loader.dll is native: extract it from the single-file bundle at runtime -->
    <IncludeNativeLibrariesForSelfExtract>true</IncludeNativeLibrariesForSelfExtract>
  </PropertyGroup>
  <ItemGroup>
    <Using Remove="System.Windows.Forms" />
    <Using Remove="System.Drawing" />
  </ItemGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.Web.WebView2" Version="1.0.2903.40" />
    <PackageReference Include="NetMQ" Version="4.0.4.5" /><PackageReference Include="SkiaSharp" Version="2.88.9" />
    <PackageReference Include="System.Security.Cryptography.ProtectedData" Version="8.0.0" />
  </ItemGroup>
  <ItemGroup><Resource Include="app.ico" /><EmbeddedResource Include="Web\chat-observer.js" LogicalName="EpikStreamer.Web.chat-observer.js" /></ItemGroup>
  <!-- If an ffmpeg\ folder exists next to the project, ship it next to the exe. -->
  <ItemGroup Condition="Exists('ffmpeg\ffmpeg.exe')">
    <None Include="ffmpeg\*.exe" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" ExcludeFromSingleFile="true" />
  </ItemGroup>
</Project>
