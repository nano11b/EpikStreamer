<Application x:Class="EpikStreamer.App" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" StartupUri="MainWindow.xaml">
  <Application.Resources>
    <SolidColorBrush x:Key="Bg" Color="#1E1E24"/>
    <SolidColorBrush x:Key="Panel" Color="#2A2A33"/>
    <SolidColorBrush x:Key="Border" Color="#3C3C48"/>
    <SolidColorBrush x:Key="Fg" Color="#E6E6EA"/>
    <SolidColorBrush x:Key="Dim" Color="#9A9AA8"/>
    <SolidColorBrush x:Key="Accent" Color="#7C5CFF"/>
    <Style TargetType="TextBlock"><Setter Property="Foreground" Value="{StaticResource Fg}"/><Setter Property="VerticalAlignment" Value="Center"/><Setter Property="Margin" Value="0,0,8,0"/></Style>
    <Style TargetType="Label"><Setter Property="Foreground" Value="{StaticResource Fg}"/></Style>
    <Style TargetType="TextBox"><Setter Property="Background" Value="{StaticResource Panel}"/><Setter Property="Foreground" Value="{StaticResource Fg}"/><Setter Property="BorderBrush" Value="{StaticResource Border}"/><Setter Property="Padding" Value="4"/><Setter Property="Margin" Value="0,3"/><Setter Property="CaretBrush" Value="White"/><Setter Property="VerticalContentAlignment" Value="Center"/></Style>
    <Style TargetType="PasswordBox"><Setter Property="Background" Value="{StaticResource Panel}"/><Setter Property="Foreground" Value="{StaticResource Fg}"/><Setter Property="BorderBrush" Value="{StaticResource Border}"/><Setter Property="Padding" Value="4"/><Setter Property="Margin" Value="0,3"/><Setter Property="CaretBrush" Value="White"/></Style>
    <Style TargetType="CheckBox"><Setter Property="Foreground" Value="{StaticResource Fg}"/><Setter Property="Margin" Value="0,4,16,4"/><Setter Property="VerticalAlignment" Value="Center"/></Style>
    <Style TargetType="ComboBox"><Setter Property="Margin" Value="0,3"/><Setter Property="Padding" Value="6,3"/><Setter Property="MinWidth" Value="120"/></Style>
    <Style TargetType="Slider"><Setter Property="VerticalAlignment" Value="Center"/><Setter Property="Margin" Value="0,3,8,3"/></Style>
    <Style TargetType="GroupBox"><Setter Property="Foreground" Value="{StaticResource Fg}"/><Setter Property="BorderBrush" Value="{StaticResource Border}"/><Setter Property="Margin" Value="0,4"/><Setter Property="Padding" Value="8"/></Style>
    <Style TargetType="ListBox"><Setter Property="Background" Value="{StaticResource Panel}"/><Setter Property="Foreground" Value="{StaticResource Fg}"/><Setter Property="BorderBrush" Value="{StaticResource Border}"/></Style>
    <Style TargetType="Button">
      <Setter Property="Background" Value="{StaticResource Accent}"/><Setter Property="Foreground" Value="White"/>
      <Setter Property="BorderThickness" Value="0"/><Setter Property="Padding" Value="12,5"/><Setter Property="Margin" Value="6,3,0,3"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="Button">
            <Border x:Name="b" Background="{TemplateBinding Background}" CornerRadius="4" Padding="{TemplateBinding Padding}">
              <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
            </Border>
            <ControlTemplate.Triggers>
              <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="b" Property="Opacity" Value="0.85"/></Trigger>
              <Trigger Property="IsEnabled" Value="False"><Setter TargetName="b" Property="Opacity" Value="0.35"/></Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>
    <Style x:Key="Secondary" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}"><Setter Property="Background" Value="#3A3A46"/></Style>
    <Style TargetType="TabControl"><Setter Property="Background" Value="{StaticResource Bg}"/><Setter Property="BorderBrush" Value="{StaticResource Border}"/></Style>
    <Style TargetType="TabItem">
      <Setter Property="Foreground" Value="{StaticResource Fg}"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="TabItem">
            <Border x:Name="b" Background="{StaticResource Panel}" Padding="14,6" Margin="0,0,2,0" CornerRadius="4,4,0,0">
              <ContentPresenter ContentSource="Header"/>
            </Border>
            <ControlTemplate.Triggers>
              <Trigger Property="IsSelected" Value="True"><Setter TargetName="b" Property="Background" Value="{StaticResource Accent}"/></Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>
  </Application.Resources>
</Application>
