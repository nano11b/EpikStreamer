<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType><TargetFramework>net8.0</TargetFramework><Nullable>enable</Nullable>
    <NoWarn>$(NoWarn);CS8600;CS8601;CS8602;CS8604</NoWarn><ImplicitUsings>enable</ImplicitUsings>
    <RootNamespace>EpikStreamer</RootNamespace><AssemblyName>epikstreamer</AssemblyName>
    <Version>2.4.1</Version><Product>EpikStreamer</Product>
    <RuntimeIdentifiers>linux-x64;linux-arm64</RuntimeIdentifiers>
    <InvariantGlobalization>true</InvariantGlobalization>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <AvaloniaUseCompiledBindingsByDefault>false</AvaloniaUseCompiledBindingsByDefault>
    <NoWarn>$(NoWarn);CA1416</NoWarn>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Avalonia" Version="11.3.2" />
    <PackageReference Include="Avalonia.Desktop" Version="11.3.2" />
    <PackageReference Include="Avalonia.Themes.Fluent" Version="11.3.2" />
    <PackageReference Include="Avalonia.Fonts.Inter" Version="11.3.2" />
  </ItemGroup>
  <ItemGroup><ProjectReference Include="../EpikStreamer.Core/EpikStreamer.Core.csproj" /></ItemGroup>
  <ItemGroup><AvaloniaResource Include="Assets/**" /></ItemGroup>
</Project>
