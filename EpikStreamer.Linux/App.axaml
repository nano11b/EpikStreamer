<Application xmlns="https://github.com/avaloniaui" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="clr-namespace:EpikStreamer" x:Class="EpikStreamer.App" RequestedThemeVariant="Dark" Name="EpikStreamer">
  <Application.Resources>
    <!-- Theme brushes: ThemeManager replaces these at runtime (same palette names as the Windows app). -->
    <SolidColorBrush x:Key="Bg" Color="#1E1E24"/>
    <SolidColorBrush x:Key="Panel" Color="#2A2A33"/>
    <SolidColorBrush x:Key="Border" Color="#3C3C48"/>
    <SolidColorBrush x:Key="Fg" Color="#E6E6EA"/>
    <SolidColorBrush x:Key="Dim" Color="#9A9AA8"/>
    <SolidColorBrush x:Key="Accent" Color="#7C5CFF"/>
    <SolidColorBrush x:Key="AccentFg" Color="#FFFFFF"/>
    <SolidColorBrush x:Key="SecondaryBg" Color="#3A3A46"/>
    <SolidColorBrush x:Key="Hover" Color="#34343F"/>
    <SolidColorBrush x:Key="Input" Color="#2A2A33"/>
    <SolidColorBrush x:Key="Thumb" Color="#55556A"/>
    <ControlTheme x:Key="{x:Type local:GroupBox}" TargetType="local:GroupBox">
      <Setter Property="Margin" Value="0,4"/><Setter Property="Padding" Value="10,8"/>
      <Setter Property="Template">
        <ControlTemplate>
          <Border BorderBrush="{DynamicResource Border}" BorderThickness="1" CornerRadius="5" Padding="{TemplateBinding Padding}" Background="{DynamicResource Panel}">
            <DockPanel>
              <ContentPresenter DockPanel.Dock="Top" Content="{TemplateBinding Header}" FontWeight="SemiBold" Foreground="{DynamicResource Fg}" Margin="0,0,0,6"/>
              <ContentPresenter Content="{TemplateBinding Content}"/>
            </DockPanel>
          </Border>
        </ControlTemplate>
      </Setter>
    </ControlTheme>
  </Application.Resources>
  <Application.Styles>
    <FluentTheme DensityStyle="Compact"/>
    <Style Selector="Window"><Setter Property="Background" Value="{DynamicResource Bg}"/><Setter Property="Foreground" Value="{DynamicResource Fg}"/><Setter Property="FontSize" Value="13"/></Style>
    <Style Selector="StackPanel > TextBlock, WrapPanel > TextBlock, Grid > TextBlock, DockPanel > TextBlock">
      <Setter Property="VerticalAlignment" Value="Center"/><Setter Property="Margin" Value="0,0,8,0"/>
    </Style>
    <Style Selector="TextBox"><Setter Property="Margin" Value="0,3"/><Setter Property="Background" Value="{DynamicResource Input}"/><Setter Property="BorderBrush" Value="{DynamicResource Border}"/><Setter Property="VerticalContentAlignment" Value="Center"/></Style>
    <Style Selector="CheckBox"><Setter Property="Margin" Value="0,2,16,2"/><Setter Property="VerticalAlignment" Value="Center"/></Style>
    <Style Selector="RadioButton"><Setter Property="Margin" Value="0,2,12,2"/></Style>
    <Style Selector="Slider"><Setter Property="Margin" Value="0,0,8,0"/><Setter Property="VerticalAlignment" Value="Center"/></Style>
    <Style Selector="ComboBox"><Setter Property="Margin" Value="0,3,6,3"/><Setter Property="VerticalAlignment" Value="Center"/></Style>
    <Style Selector="ListBox"><Setter Property="Background" Value="{DynamicResource Input}"/><Setter Property="BorderBrush" Value="{DynamicResource Border}"/><Setter Property="BorderThickness" Value="1"/></Style>
    <Style Selector="ListBoxItem"><Setter Property="Padding" Value="6,3"/><Setter Property="MinHeight" Value="0"/></Style>
    <Style Selector="ListBoxItem:selected /template/ ContentPresenter#PART_ContentPresenter"><Setter Property="Background" Value="{DynamicResource Accent}"/><Setter Property="Foreground" Value="{DynamicResource AccentFg}"/></Style>
    <Style Selector="TabItem"><Setter Property="FontSize" Value="14"/><Setter Property="MinHeight" Value="34"/><Setter Property="Padding" Value="10,2"/></Style>
    <Style Selector="TabItem:selected /template/ Border#PART_SelectedPipe"><Setter Property="Background" Value="{DynamicResource Accent}"/></Style>
    <Style Selector="Button"><Setter Property="Background" Value="{DynamicResource Accent}"/><Setter Property="Foreground" Value="{DynamicResource AccentFg}"/>
      <Setter Property="Margin" Value="6,3,0,3"/><Setter Property="Padding" Value="12,5"/><Setter Property="CornerRadius" Value="4"/><Setter Property="VerticalAlignment" Value="Center"/></Style>
    <Style Selector="Button.secondary:pointerover /template/ ContentPresenter#PART_ContentPresenter, Button.secondary:pressed /template/ ContentPresenter#PART_ContentPresenter, Button.secondary:disabled /template/ ContentPresenter#PART_ContentPresenter"><Setter Property="Background" Value="{DynamicResource SecondaryBg}"/><Setter Property="Foreground" Value="{DynamicResource Fg}"/></Style>
    <Style Selector="TextBox"><Setter Property="Text" Value=""/></Style>
    <Style Selector="AutoCompleteBox"><Setter Property="Text" Value=""/></Style>
    <Style Selector="Button.secondary"><Setter Property="Background" Value="{DynamicResource SecondaryBg}"/><Setter Property="Foreground" Value="{DynamicResource Fg}"/></Style>
    <Style Selector="Button:pointerover /template/ ContentPresenter#PART_ContentPresenter, Button:pressed /template/ ContentPresenter#PART_ContentPresenter">
      <Setter Property="Background" Value="{DynamicResource Accent}"/><Setter Property="Foreground" Value="{DynamicResource AccentFg}"/><Setter Property="Opacity" Value="0.85"/></Style>
    <Style Selector="Button:disabled /template/ ContentPresenter#PART_ContentPresenter"><Setter Property="Background" Value="{DynamicResource Accent}"/><Setter Property="Foreground" Value="{DynamicResource AccentFg}"/><Setter Property="Opacity" Value="0.35"/></Style>
    <Style Selector="ToggleButton"><Setter Property="Background" Value="{DynamicResource SecondaryBg}"/><Setter Property="Foreground" Value="{DynamicResource Fg}"/>
      <Setter Property="Margin" Value="6,3,0,3"/><Setter Property="Padding" Value="10,5"/><Setter Property="CornerRadius" Value="4"/><Setter Property="VerticalAlignment" Value="Center"/></Style>
    <Style Selector="ToggleButton:checked /template/ ContentPresenter#PART_ContentPresenter"><Setter Property="Background" Value="{DynamicResource Accent}"/><Setter Property="Foreground" Value="{DynamicResource AccentFg}"/></Style>
    <Style Selector="ToggleButton:pointerover:unchecked /template/ ContentPresenter#PART_ContentPresenter"><Setter Property="Background" Value="{DynamicResource Hover}"/><Setter Property="Foreground" Value="{DynamicResource Fg}"/></Style>
  </Application.Styles>
</Application>
